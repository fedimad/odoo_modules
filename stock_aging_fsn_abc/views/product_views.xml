<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_obsolete" model="ir.ui.view">
        <field name="name">product.template.form.obsolete</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_general']" position="inside">
                <field name="is_obsolete"/>
            </xpath>
        </field>
    </record>

    <record id="product_template_search_view_obsolete" model="ir.ui.view">
        <field name="name">product.template.search.obsolete</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter name="filter_obsolete" string="Obsolete" domain="[('is_obsolete', '=', True)]"/>
            </xpath>
        </field>
    </record>
</odoo>
