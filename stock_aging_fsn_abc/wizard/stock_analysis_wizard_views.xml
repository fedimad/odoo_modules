<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_analysis_wizard_form" model="ir.ui.view">
        <field name="name">stock.analysis.wizard.form</field>
        <field name="model">stock.analysis.wizard</field>
        <field name="arch" type="xml">
            <form string="Stock Analysis">
                <group>
                    <group string="Report">
                        <field name="report_type"/>
                        <field name="as_of_date"/>
                        <field name="output_format" invisible="report_type == 'loss'"/>
                        <field name="company_id" 
                               options="{'no_create': True}"/>
                    </group>
                    <group string="Filters">
                        <field name="warehouse_ids" widget="many2many_tags"
                               domain="[('company_id', '=', company_id)]"
                               options="{'no_create': True}"/>
                        <field name="location_ids" widget="many2many_tags"
                               domain="[('usage', '=', 'internal'), ('company_id', '=', company_id)]"
                               options="{'no_create': True}"/>
                        <field name="category_ids" widget="many2many_tags"
                               options="{'no_create': True}"/>
                        <field name="product_ids" widget="many2many_tags"
                               options="{'no_create': True}"/>
                    </group>
                </group>
                <group string="Aging options" invisible="report_type != 'aging'">
                    <group>
                        <field name="bucket_1"/>
                        <field name="bucket_2"/>
                        <field name="bucket_3"/>
                        <field name="bucket_4"/>
                    </group>
                    <group>
                        <field name="lot_level"/>
                        <field name="flag_obsolete" groups="stock.group_stock_manager"/>
                    </group>
                </group>
                <group string="Period" invisible="report_type == 'aging'">
                    <field name="lookback_days"/>
                    <field name="fsn_fast_ratio" invisible="report_type != 'fsn'"/>
                </group>
                <group string="ABC bands" invisible="report_type != 'abc'">
                    <field name="abc_a_pct"/>
                    <field name="abc_b_pct"/>
                </group>
                <footer>
                    <button string="Generate" name="action_print" type="object" class="btn-primary"
                            data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_stock_aging_wizard" model="ir.actions.act_window">
        <field name="name">Inventory Aging</field>
        <field name="res_model">stock.analysis.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_report_type': 'aging'}</field>
    </record>
    <record id="action_stock_fsn_wizard" model="ir.actions.act_window">
        <field name="name">FSN Analysis</field>
        <field name="res_model">stock.analysis.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_report_type': 'fsn'}</field>
    </record>
    <record id="action_stock_abc_wizard" model="ir.actions.act_window">
        <field name="name">ABC Analysis</field>
        <field name="res_model">stock.analysis.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_report_type': 'abc'}</field>
    </record>
    <record id="action_stock_loss_wizard" model="ir.actions.act_window">
        <field name="name">Inventory Loss</field>
        <field name="res_model">stock.analysis.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_report_type': 'loss'}</field>
    </record>

    <menuitem id="menu_stock_analysis_root" name="Aging &amp; Analysis"
              parent="stock.menu_warehouse_report" sequence="60"
              groups="base.group_system,stock.group_stock_user"/>
    <menuitem id="menu_stock_aging" name="Inventory Aging" parent="menu_stock_analysis_root"
              action="action_stock_aging_wizard" sequence="10"/>
    <menuitem id="menu_stock_fsn" name="FSN Analysis" parent="menu_stock_analysis_root"
              action="action_stock_fsn_wizard" sequence="20"/>
    <menuitem id="menu_stock_abc" name="ABC Analysis" parent="menu_stock_analysis_root"
              action="action_stock_abc_wizard" sequence="30"/>
    <menuitem id="menu_stock_loss" name="Inventory Loss" parent="menu_stock_analysis_root"
              action="action_stock_loss_wizard" sequence="40"/>
</odoo>
