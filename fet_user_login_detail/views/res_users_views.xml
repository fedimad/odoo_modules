<?xml version="1.0" encoding="utf-8"?>
<odoo>
    

        <record id="fet_view_users_form_inherit"  model="ir.ui.view">
            <field name="name">fet res user form commune</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="priority">20</field>
            <field name="arch" type="xml">

                <xpath expr="//notebook" position="inside">
                    <page string="Sessions">

                        <field name="login_detail_ids">
                            <kanban class="o_kanban_small_column">
                                <field name="user_id"/>
                                <field name="ip_address"/>
                                <field name="user_agent"/>
                                <field name="status"/>
                                <field name="login_date"/>

                                <templates>
                                    <t t-name="kanban-box">
                                        <div class="oe_kanban_global_click o_kanban_card">

                                            <!-- Header -->
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <div>
                                                    <strong>
                                                        <field name="user_id"/>
                                                    </strong>
                                                    <div class="text-muted small">
                                                        <field name="login"/>
                                                    </div>
                                                </div>

                                                <!-- Status badge -->
                                                <span t-if="record.status.raw_value == 'success'"
                                                      class="badge bg-success">
                                                    Active
                                                </span>
                                                <span t-if="record.status.raw_value == 'failed'"
                                                      class="badge bg-secondary">
                                                    Inactive
                                                </span>
                                            </div>

                                            <!-- Device / Browser -->
                                            <div class="text-muted small d-flex align-items-center gap-3">
                                                <!-- Device -->
                                                <span>
                                                    <i class="fa fa-desktop me-1"/>
                                                    <field name="device"/>
                                                </span>

                                                <!-- OS -->
                                                <span>
                                                    <i t-if="record.os.raw_value == 'Windows 10'" class="fa fa-windows me-1"/>
                                                    <i t-if="record.os.raw_value == 'Linux'" class="fa fa-linux me-1"/>
                                                    <i t-if="record.os.raw_value == 'Mac'" class="fa fa-apple me-1"/>
                                                    <field name="os"/>
                                                </span>

                                                <!-- Browser -->
                                                <span>
                                                    <i class="fa fa-chrome me-1"/>
                                                    <field name="browser"/>
                                                </span>

                                            </div>

                                            <!-- IP -->
                                            <div class="text-muted small">
                                                <i class="fa fa-globe me-1"/>
                                                <field name="ip_address"/>
                                            </div>

                                            <!-- Date -->
                                            <div class="text-muted small">
                                                <i class="fa fa-clock me-1"/>
                                                Last Activity:
                                                <field name="login_date"/>
                                            </div>

                                            <!-- Button -->
                                            <div class="mt-3">
                                                <button type="object"
                                                        name="action_kill_session"
                                                        class="btn btn-danger w-100"
                                                        t-if="record.status.raw_value == 'success'">
                                                    End Session
                                                </button>
                                            </div>

                                        </div>
                                    </t>
                                </templates>
                            </kanban>
                        </field>
                    </page>
                </xpath>

            </field>
        </record>


</odoo>