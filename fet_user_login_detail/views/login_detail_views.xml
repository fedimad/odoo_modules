<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form view -->
    <record id="login_detail_view_form" model="ir.ui.view">
        <field name="name">login.detail.view.form</field>
        <field name="model">login.detail</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_kill_session" 
                        string="End Session" 
                        type="object" 
                        class="btn-danger"
                        invisible="is_session_active == 'false'"
                        confirm="Are you sure you want to end this session?"/>
                    <button name="action_verify_session" 
                        string="Verify Session" 
                        type="object" 
                        class="btn-info"/>
                    <field name="status" widget="statusbar" />
                </header>
                <sheet>
                    <group>
                        <group string="Login Information">
                            <field name="login"/>
                            <field name="user_id"/>
                            <field name="session_id"/>
                            <field name="is_session_active" />
                            
                        </group>
                        <group string="Date">
                            <field name="login_date"/>
                        </group>
                        <group string="Device information">
                            <field name="device"/>
                            <field name="os"/>
                            <field name="browser"/>
                        </group>
                        <group string="IP/Agent">
                            <field name="ip_address"/>
                            <field name="user_agent"/>
                        </group>
                    </group>
                    <field name="message"/>
                </sheet>
            </form>
        </field>
    </record>
    <!-- Tree view -->
    <record id="login_detail_view_tree" model="ir.ui.view">
        <field name="name">login.detail.view.tree</field>
        <field name="model">login.detail</field>
        <field name="arch" type="xml">
            <tree>
                <field name="active"/>
                <field name="login_date"/>
                <field name="login"/>
                <field name="user_id"/>
                <field name="ip_address"/>
                <field name="user_agent"/>
                <field name="status" widget="badge" decoration-success="status=='success'" decoration-danger="status=='failed'"/>
                <field name="is_session_active" widget="boolean" decoration-success="is_session_active==True" decoration-danger="is_session_active==False"/>
            </tree>
        </field>
    </record>

    <record id="view_login_detail_kanban" model="ir.ui.view">
        <field name="name">login.detail.kanban</field>
        <field name="model">login.detail</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column">
                <field name="user_id"/>
                <field name="ip_address"/>
                <field name="user_agent"/>
                <field name="status"/>
                <field name="login_date"/>

                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_card">

                            <!-- Header -->
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div>
                                    <strong>
                                        <field name="user_id"/>
                                    </strong>
                                    <div class="text-muted small">
                                        <field name="login"/>
                                    </div>
                                </div>

                                <!-- Status badge -->
                                <span t-if="record.status.raw_value == 'success'"
                                      class="badge bg-success">
                                    Active
                                </span>
                                <span t-if="record.status.raw_value == 'failed'"
                                      class="badge bg-secondary">
                                    Inactive
                                </span>
                            </div>

                            <!-- Device / Browser -->
                            <div class="text-muted small d-flex align-items-center gap-3">
                                <!-- Device -->
                                <span>
                                    <i class="fa fa-desktop me-1"/>
                                    <field name="device"/>
                                </span>

                                <!-- OS -->
                                <span>
                                    <i t-if="record.os.raw_value == 'Windows 10'" class="fa fa-windows me-1"/>
                                    <i t-if="record.os.raw_value == 'Linux'" class="fa fa-linux me-1"/>
                                    <i t-if="record.os.raw_value == 'Mac'" class="fa fa-apple me-1"/>
                                    <field name="os"/>
                                </span>

                                <!-- Browser -->
                                <span>
                                    <i class="fa fa-chrome me-1"/>
                                    <field name="browser"/>
                                </span>

                            </div>

                            <!-- IP -->
                            <div class="text-muted small">
                                <i class="fa fa-globe me-1"/>
                                <field name="ip_address"/>
                            </div>

                            <!-- Date -->
                            <div class="text-muted small">
                                <i class="fa fa-clock me-1"/>
                                Last Activity:
                                <field name="login_date"/>
                            </div>

                            <!-- Button -->
                            <div class="mt-3">
                                <button type="object"
                                        name="action_kill_session"
                                        class="btn btn-danger w-100"
                                        t-if="record.status.raw_value == 'success'">
                                    End Session
                                </button>
                            </div>

                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="login_detail_view_search" model="ir.ui.view">
        <field name="name">login.detail.view.search</field>
        <field name="model">login.detail</field>
        <field name="arch" type="xml">
            <search>

                <!-- Fields -->
                <field name="user_id" string="Utilisateur"/>
                <field name="login"/>
                <field name="login_date"/>
                <field name="status"/>
                <field name="active" invisible="1"/>

                <separator/>

                <filter name="today"
                    string="Date"
                    domain="[
                        ('login_date', '>=', context_today()),
                        ('login_date', '&lt;', context_today())
                    ]"
                    context="{'group_by': 'login_date:day'}"/>
                <filter name="success"
                        string="Success"
                        domain="[('status','=','success')]"/>

                <filter name="failed"
                        string="Failed"
                        domain="[('status','=','failed')]"/>

                <separator/>
                <filter name="active"
                        string="Archive"
                        domain="[('active', '=', False)]"/>

                <!-- Group By -->
                <group expand="0" string="Group By">
                    <filter name="group_status"
                            string="État"
                            context="{'group_by':'status'}"/>

                    <filter name="group_user"
                            string="User"
                            context="{'group_by':'user_id'}"/>

                    <filter name="group_date"
                            string="Date"
                            context="{'group_by':'login_date:day'}"/>
                </group>

            </search>
        </field>
    </record>


    <!-- Action for Login Details menu item -->
    <record id="login_detail_action" model="ir.actions.act_window">
        <field name="name">Login Detail</field>
        <field name="res_model">login.detail</field>
        <field name="context">{'search_default_today': 1}</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>
    <!-- Login Details menu item -->
    <menuitem name="Login Details" id="fet_user_login_detail.login_detail_menu" parent="base.menu_users"
              action="login_detail_action"/>
</odoo>
